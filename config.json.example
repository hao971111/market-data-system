{
    "data_sources": [
        {
            "name": "binance_main",
            "ws_url": "wss://stream.binance.com:9443/stream",
            "priority": 0,
            "enabled": true
        }
    ],
    "symbols": ["btcusdt", "ethusdt", "solusdt"],
    "data_dir": "./data",
    "ring_buffer_size": 100000,
    "reconnect_interval_ms": 100,
    "ping_interval_ms": 1000,
    "no_data_timeout_ms": 3000,
    "proxy_url": "",
    "log_level": 1
}
